{
    "name": "smartcamera",
    "version": "1.0.0",
    "main": "index.js",
    "license": "MIT",
    "scripts": {
        "type": "yarn tsc --noEmit",
        "env": "typenode ./scripts/env.ts",
        "uv": "python -m uv --project python",
        "py": "yarn uv run python -u",
        "sync": "yarn uv sync",
        "trt:probe": "yarn py python/probeTrt.py",
        "quant:probe": "yarn py python/probeQuant.py",
        "download": "yarn py python/download.py",
        "inspect": "yarn py python/inspect_model.py",
        "export:vision": "yarn py python/exportVision.py",
        "build:vision": "yarn py python/buildVision.py",
        "bench:vision": "yarn py python/benchVision.py",
        "export:decoder": "yarn py python/exportDecoder.py",
        "calibrate": "yarn py python/calibrate.py",
        "calib:analyze": "yarn py python/analyzeCalibration.py",
        "quantize": "yarn py python/quantizeFp8.py",
        "quantize:int8": "yarn py python/quantizeInt8.py",
        "build:decoder": "yarn py python/buildDecoder.py",
        "answer": "yarn py python/benchAnswer.py",
        "clean": "yarn py python/clean.py",
        "stop": "yarn py python/stopStray.py",
        "engine": "yarn py python/useEngine.py",
        "accuracy": "yarn py python/checkAccuracy.py",
        "names": "yarn py python/inspectNames.py",
        "debug:logits": "yarn py python/debugLogits.py",
        "debug:layers": "yarn py python/debugLayers.py",
        "smart": "typenode ./smart.ts",
        "probe": "typenode ./probe.ts",
        "eye": "typenode ./smart.ts %USERPROFILE%/Desktop/view2.bat medium upsidedown",
        "ask": "typenode ./ask.ts %USERPROFILE%/Desktop/view2.bat upsidedown",
        "capture": "typenode ./capture.ts",
        "capture:muxprobe": "typenode ./scripts/muxProbe.ts",
        "capture:probe": "typenode ./scripts/probeVideo.ts",
        "decoderate": "typenode ./scripts/decodeRate.ts",
        "jpegrate": "typenode ./scripts/jpegRate.ts",
        "eye2": "typenode ./eye2.ts",
        "ask2": "typenode ./scripts/eye2Ask.ts",
        "ask2:concurrent": "typenode ./scripts/eye2Concurrent.ts",
        "ask2:security": "typenode ./scripts/eye2Security.ts",
        "smartpause": "typenode ./smartpause.ts 2",
        "autopause": "typenode ./autopause.ts %USERPROFILE%/Desktop/view2.bat",
        "bench:quant": "typenode ./scripts/benchQuant.ts",
        "watch": "typenode ./scripts/watch.ts",
        "actions": "typenode ./actions.ts",
        "daemon": "./scripts/eyed",
        "daemon:install": "./scripts/eyed install",
        "daemon:start": "./scripts/eyed start",
        "daemon:stop": "./scripts/eyed stop",
        "daemon:restart": "./scripts/eyed restart",
        "daemon:status": "./scripts/eyed status",
        "daemon:logs": "./scripts/eyed logs",
        "test:questions": "typenode ./scripts/questions.test.ts",
        "password": "typenode ./scripts/password.ts",
        "test:client": "typenode ./scripts/eyeClient.test.ts"
    },
    "dependencies": {
        "jpeg-js": "*",
        "node-av": "*",
        "onnxruntime-node": "*",
        "sliftutils": "^1.7.121",
        "socket-function": "*",
        "ws": "*"
    }
}
